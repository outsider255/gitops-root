            {"id": "b1", "name": "title", "type": "string", "value": "={{ ({deep_focus: 'Deep Focus Terrarium for Coding & Study 🍃 | Moss & Melodies Lofi', rainy_day: 'Rainy Windowsill Session for Relaxation 🌧️ | Moss & Melodies Lofi', night_focus: 'Bioluminescent Night Focus for Late Work 🌙 | Moss & Melodies Lofi', gentle_morning: 'Dawn Terrarium — Gentle Morning Focus ☕ | Moss & Melodies Lofi'})[$json.category] }}"},
            {"id": "b2", "name": "hashtags", "type": "string", "value": "={{ ({deep_focus: '#codingmusic #deepfocus #productivity', rainy_day: '#rainsounds #cozyvibes #ambientmusic', night_focus: '#latenightstudy #nightowl #darkacademia', gentle_morning: '#morningroutine #softvibes #daystart'})[$json.category] }}"},
            {"id": "b3", "name": "description", "type": "string", "value": "=[TODO: category-specific mood paragraph per BRAND-CONCEPT.md §3.4]\n\n🌿 [TODO: scene description sentence]\n\n🎵 [TODO: music description sentence]\n\n---\n🔗 Focus better with GrowFocus.app: https://growfocus.app/?utm_source=youtube&utm_medium=qr&utm_campaign=lofi&utm_content={{$json.video_id}}\n📌 Subscribe for more lofi focus sessions: [channel link]\n\n#lofi #studybeats #focusmusic #mossandmelodies {{ ({deep_focus: '#codingmusic #deepfocus #productivity', rainy_day: '#rainsounds #cozyvibes #ambientmusic', night_focus: '#latenightstudy #nightowl #darkacademia', gentle_morning: '#morningroutine #softvibes #daystart'})[$json.category] }}"}
          ]
        },
        "options": {}
      },
      "id": "7",
      "name": "Build Title And Description",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [690, 480]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://render-service.render-service.svc.cluster.local/render",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { job_id: $json.job_id, video_id: $json.video_id, category: $json.category, track_ids: $json.track_ids, loop_ids: $json.loop_ids, overlay_config: { qr_url: \"https://growfocus.app/?utm_source=youtube&utm_medium=qr&utm_campaign=lofi&utm_content=\" + $json.video_id }, output_path: $json.output_path } }}",
        "options": {}
      },
      "id": "3",
      "name": "Dispatch Render",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [690, 300]
    },
    {
      "parameters": {
        "amount": 5,
        "unit": "seconds"
      },
      "id": "4",
      "name": "Wait For Render",
